<Page x:Class="WPFAPP.Pages.WhiteListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Белый список"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#20000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#673AB7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5E35B1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для строк списка -->
        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EDE7F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Белый список приложений" 
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,20"/>

                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="AddAppBtn" 
                            Style="{StaticResource PrimaryButton}"
                            Width="180"
                            Height="40"
                            Click="AddAppBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PlusCircle" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Добавить приложение"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RemoveAppBtn" 
                            Style="{StaticResource WarningButton}"
                            Width="180"
                            Height="40"
                            Margin="10,0,0,0"
                            Click="RemoveAppBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Удалить выбранное"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshBtn"  
                      Style="{StaticResource PrimaryButton}"
                      Width="50"
                      Height="40"
                      Margin="10,0,0,0"
                      ToolTip="Обновить список"
                      Click="RefreshBtn_Click">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>

                </StackPanel>

                <!-- Статистика -->
                <Border Background="#F5F5F5" 
                        CornerRadius="4" 
                        Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Information" 
                                                 Width="20" 
                                                 Height="20" 
                                                 Margin="0,0,10,0"
                                                 Foreground="#666666"/>
                        <TextBlock x:Name="StatsText"
                                   Text="Загрузка..."
                                   FontSize="13"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Список приложений -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0" 
                        Background="#FAFAFA" 
                        CornerRadius="3"
                        Padding="15,10"
                        Margin="0,0,0,10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="№"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Приложение"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"/>

                        <TextBlock Grid.Column="2"
                                   Text="Хэш SHA-256"
                                   FontWeight="SemiBold"
                                   Foreground="#666666"/>
                        
                    </Grid>
                </Border>

                <!-- Список -->
                <ListView x:Name="WhiteListListView" 
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource ListItemStyle}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Номер -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Path=(ItemsControl.AlternationIndex), 
                                                          RelativeSource={RelativeSource AncestorType=ListViewItem},
                                                          Converter={StaticResource IndexConverter}}"
                                           Padding="5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#666666"/>

                                <!-- Название -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}" 
                                           Padding="10,8"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Полный хэш (с переносами) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FullHash}" 
                                           Padding="10,8"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#666666"
                                           TextWrapping="Wrap"/>
                              
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Пустой список -->
                <Border Grid.Row="1"
                        x:Name="EmptyListPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="FileQuestion" 
                                                 Width="64" 
                                                 Height="64" 
                                                 Foreground="#E0E0E0"
                                                 Margin="0,0,0,20"/>
                        <TextBlock Text="Белый список пуст" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавьте первое приложение" 
                                   FontSize="13"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>