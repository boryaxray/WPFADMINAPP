<Page x:Class="WPFAPP.Pages.WhiteListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:local="clr-namespace:WPFAPP.Converters"
      Title="Белый список"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.06" Color="#000000"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="6" ShadowDepth="2" Opacity="0.12" Color="#000000"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#673AB7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#F44336"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2196F3"/>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#FF9800"/>
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="0,1"
                                Padding="12,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EDE7F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Конвертер для индекса -->
        <local:IndexConverter x:Key="IndexConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="12" 
                Padding="24"
                Margin="0,0,0,15"
                Effect="{StaticResource CardShadow}">
            <StackPanel>
                <!-- Заголовок и кнопки -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Белый список приложений" 
                                   FontSize="20" FontWeight="Bold" 
                                   Foreground="#1A1A2E"/>
                        <TextBlock Text="Управление разрешенными программами" 
                                   FontSize="13" 
                                   Foreground="#999999"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshBtn" 
                                Style="{StaticResource InfoButton}"
                                Width="120" Height="38"
                                Margin="0,0,10,0"
                                Click="RefreshBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Обновить"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Кнопки действий -->
                <WrapPanel>
                    <Button x:Name="AddAppBtn" 
                            Style="{StaticResource ModernButton}"
                            Width="200" Height="42"
                            Margin="0,0,10,8"
                            Click="AddAppBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PlusCircle" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Добавить приложение"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RemoveAppBtn" 
                            Style="{StaticResource DangerButton}"
                            Width="200" Height="42"
                            Margin="0,0,10,8"
                            Click="RemoveAppBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Удалить"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CheckHashesBtn" 
                            Style="{StaticResource InfoButton}"
                            Width="200" Height="42"
                            Margin="0,0,10,8"
                            Click="CheckHashesBtn_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldSearch" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Проверить хеши"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UpdateAllBtn" 
                            Style="{StaticResource SuccessButton}"
                            Width="200" Height="42"
                            Margin="0,0,10,8"
                            Click="UpdateAllBtn_Click"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Обновить всё"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Статистика -->
                <Border Background="#F8F9FA" 
                        CornerRadius="8" 
                        Padding="16"
                        Margin="0,15,0,0"
                        BorderBrush="#E9ECEF"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                 Width="18" Height="18" 
                                                 Margin="0,0,10,0"
                                                 Foreground="#673AB7"/>
                        <TextBlock x:Name="StatsText"
                                   Text="Загрузка..."
                                   FontSize="13"
                                   Foreground="#666666"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Список приложений -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="12" 
                Padding="0"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        CornerRadius="12,12,0,0"
                        Padding="16,12"
                        BorderBrush="#E9ECEF"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="№"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Приложение"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontSize="12"
                                   Margin="5,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="Хэш SHA-256"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontSize="12"
                                   Margin="5,0"/>

                        <TextBlock Grid.Column="3"
                                   Text="Статус"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text=""
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Список -->
                <ListView x:Name="WhiteListListView" 
                          Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource ListItemStyle}"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- Номер -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, 
                                                          Converter={StaticResource IndexConverter}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="#999999"
                                           FontWeight="Medium"/>

                                <!-- Название -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}" 
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#333333"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="5,0"/>

                                <!-- Хэш -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FullHash}" 
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#888888"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="5,0"/>

                                <!-- Статус -->
                                <Border Grid.Column="3" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"
                                        CornerRadius="12" 
                                        Padding="10,4"
                                        Background="{Binding StatusColor}">
                                    <TextBlock Text="{Binding Status}" 
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Кнопка обновления -->
                                <Button Grid.Column="4" 
                                        Content="Обновить" 
                                        Height="30"
                                        FontSize="11"
                                        Padding="10,4"
                                        Background="#FF9800"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="UpdateSingleHashBtn_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding HashChanged, Converter={StaticResource BoolToVisibilityConverter}}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Пустой список -->
                <Border Grid.Row="1"
                        x:Name="EmptyListPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="White">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ShieldOutline" 
                                                 Width="72" 
                                                 Height="72" 
                                                 Foreground="#E0E0E0"
                                                 Margin="0,0,0,20"/>
                        <TextBlock Text="Белый список пуст" 
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавьте приложения для контроля запуска" 
                                   FontSize="13"
                                   Foreground="#BBBBBB"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>