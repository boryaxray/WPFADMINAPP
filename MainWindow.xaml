<Window x:Class="WPFAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Application Control Manager" 
        Height="650" Width="950"
        MinHeight="800" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
      
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Тени -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.1" Color="#000000"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="5" Opacity="0.08" Color="#000000"/>
        
        <!-- Стили кнопок -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter x:Name="icon" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter x:Name="content" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4a148c"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00000020"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#663ab6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#F0F2F5" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" 
                    Background="#673AB7" 
                    CornerRadius="12,12,0,0"
                    Height="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                Margin="25,0,0,0">
                        <materialDesign:PackIcon Kind="ShieldLock" 
                                                 Width="24" Height="24" 
                                                 Foreground="White" 
                                                 Margin="0,0,12,0"/>
                        <TextBlock Text="AppControl" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Навигация -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <Button x:Name="WhiteListBtn" 
                                Content="Белый список"
                                Style="{StaticResource NavButtonStyle}"
                                Width="150"
                                Click="WhiteListBtn_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckAll" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Белый список" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Button x:Name="LogsBtn" 
                                Content="Логи"
                                Style="{StaticResource NavButtonStyle}"
                                Width="120"
                                Click="LogsBtn_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Text" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Логи" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Button x:Name="ServiceBtn" 
                                Content="Служба"
                                Style="{StaticResource NavButtonStyle}"
                                Width="120"
                                Click="ServiceBtn_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Server" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="Служба" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </StackPanel>

                    <!-- Статус и кнопки управления окном -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                Margin="0,0,15,0">
                        <!-- Статус службы -->
                        <Border
                                CornerRadius="20" 
                                Padding="12,6"
                                Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" 
                                         Width="8" Height="8" 
                                         Fill="#BDBDBD" 
                                         Margin="0,0,8,0" 
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="ServiceStatusText" 
                                           Text="Проверка..." 
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <Border Grid.Row="1" 
                    Background="#F0F2F5"
                    Margin="15,15,15,10">
                <Frame x:Name="MainFrame" 
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </Border>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="0,0,12,12"
                    Height="35"
                    BorderBrush="#E8E8E8"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="20,0">
                    <TextBlock Text="Application Control Manager v1.0" 
                               FontSize="11" 
                               Foreground="#999999"/>
                    <TextBlock Text=" | " 
                               FontSize="11" 
                               Foreground="#CCCCCC"/>
                    <TextBlock Text="Защита активна" 
                               FontSize="11" 
                               Foreground="#4CAF50"
                               FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>